# =====================================
# EmailJS Configuration (listener email, US5)
# =====================================
# Copier ce fichier en pizza-eats-api/.env puis renseigner les clés EmailJS.
# Sans ces clés, l'API démarre quand même, mais l'envoi d'email échoue
# lors d'un changement de statut de commande.

EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
